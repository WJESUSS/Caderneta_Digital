# GEMINI_API_KEY: Required for Gemini AI API calls if used in server routes.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: URL do serviço no ambiente de execução (ex.: Cloud Run).
APP_URL="https://seu-app.run.app"

# VITE_APP_PUBLIC_URL: URL pública de produção codificada no QR Code (/qr) e links.
# Em produção, defina com o endereço HTTPS final do Cloud Run (sem barra no final).
VITE_APP_PUBLIC_URL=""

# PORT: Porta HTTP do servidor Express (Cloud Run define automaticamente).
PORT="3000"

# NODE_ENV: "development" ou "production"
NODE_ENV="development"

# Firebase (configuração principal também lida de firebase-applet-config.json)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_FIRESTORE_DATABASE_ID=""
